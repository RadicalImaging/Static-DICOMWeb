{
  "name": "@radicalimaging/cs3d",
  "version": "1.7.6",
  "description": "Cornerstone3D CLI Utilities",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "Cornerstone server side",
    "DICOM"
  ],
  "author": "Rodolfo Ladeira <rodolfo2611@gmail.com>",
  "contributors": [
    "Rodolfo Costa <rodolfo.costa@radicalimaging.com>",
    "Bill Wallace <wayfarer3130@gmail.com>"
  ],
  "engines": {
    "node": ">=14.18.1",
    "npm": ">=6.14.15",
    "yarn": ">=1.22.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RadicalImaging/Static-DICOMWeb.git",
    "directory": "packages/cs3d"
  },
  "bugs": {
    "url": "https://github.com/radicalimaging/static-dicomweb/issues"
  },
  "homepage": "https://github.com/radicalimaging/static-dicomweb#readme",
  "license": "ISC",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "require": "./src/index.ts",
      "import": "./src/index.ts",
      "esm": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*.mjs": {
      "default": "./src/*.mjs",
      "import": "./src/*.mjs",
      "esm": "./dist/*.mjs",
      "types": "./dist/*.d.mts"
    },
    "./*": {
      "default": "./src/*",
      "require": "./src/*",
      "import": "./src/*",
      "esm": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "files": [
    "lib",
    "src",
    "dist",
    "bin"
  ],
  "scripts": {
    "test": "jest --config ./jest.config.js",
    "build": "pnpm run build:esm",
    "build:esm": "tsc --project ./tsconfig.json",
    "build:esm:watch": "tsc --project ./tsconfig.json --watch",
    "cs3d": "bun run src/cs3d.ts --",
    "clean": "rimraf dist",
    "link:exec": "bun link",
    "lint": "npx eslint --color \"**/*.{js,mjs,cjs}\"",
    "pack:js": "npm pack --",
    "lint:fix": "npx eslint --fix --color \"**/*.{js,mjs,cjs}\""
  },
  "dependencies": {
    "@cornerstonejs/core": "5.11.5",
    "@cornerstonejs/metadata": "5.11.5",
    "@cornerstonejs/utils": "5.11.5",
    "canvas": "3.1.0",
    "dcmjs": "0.52.0",
    "jsdom": "26.1.0",
    "jsdom-context-require": "5.2.7"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "babel-plugin-transform-import-meta": "2.3.3"
  }
}
