{
  "name": "@radicalimaging/static-wado-webserver",
  "version": "1.7.6",
  "description": "Webserver to serve a static-wado repo",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "StaticWado",
    "StaticWadoServer",
    "DICOM",
    "DICOMweb"
  ],
  "author": "Bill Wallace <bill.wallace@radicalimaging.com>",
  "contributors": [
    "Rodolfo Costa <rodolfo.costa@radicalimaging.com>"
  ],
  "engines": {
    "npm": ">=6.14.15",
    "bun": ">=1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/radicalimaging/static-dicomweb",
    "directory": "packages/static-wado-scp"
  },
  "bugs": {
    "url": "https://github.com/radicalimaging/static-dicomweb/issues"
  },
  "homepage": "https://github.com/radicalimaging/static-dicomweb#readme",
  "license": "ISC",
  "main": "lib/index.mjs",
  "module": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs",
      "esm": "./lib/index.mjs"
    }
  },
  "directories": {
    "lib": "lib",
    "dist": "dist",
    "bin": "bin"
  },
  "files": [
    "bin",
    "lib",
    "dist"
  ],
  "bin": {
    "dicomwebserver": "bin/dicomwebserver.mjs",
    "monitordicomwebserver": "bin/monitordicomwebserver.mjs"
  },
  "scripts": {
    "pretest": "bun run build:esm",
    "test": "jest --config ./jest.config.js",
    "unlink:exec": "bun unlink || echo Already unlinked",
    "link:exec": "bun run unlink:exec && bun link",
    "build": "bun run build:esm",
    "build:esm": "tsc --project ./tsconfig.json",
    "clean": "rimraf dist",
    "lint": "npx eslint --color \"**/*.{js,mjs,cjs,ts}\"",
    "lint:fix": "npx eslint --fix --color \"**/*.{js,mjs,cjs,ts}\"",
    "pack:js": "npm pack --",
    "publishJS": "yarn publish"
  },
  "dependencies": {
    "@cornerstonejs/dicom-codec": "1.0.12",
    "@radicalimaging/create-dicomweb": ">=1.7.6",
    "@radicalimaging/static-wado-plugins": ">=1.7.6",
    "@radicalimaging/static-wado-util": ">=1.7.6",
    "@saga-bus/core": "0.2.2",
    "config-point": "0.8.0",
    "content-type": "1.0.5",
    "cors": "2.8.6",
    "dcmjs": "0.50.1",
    "dcmjs-dimse": "0.1.31",
    "express": "5.2.1",
    "formidable": "3.5.4",
    "morgan": "1.10.1",
    "regenerator-runtime": "0.14.1",
    "rxjs": "7.8.2",
    "streamsearch": "1.1.0",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "7.28.5",
    "jest": "29.7.0",
    "must": "0.13.4"
  }
}
