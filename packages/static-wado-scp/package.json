{
  "name": "@radicalimaging/static-wado-scp",
  "version": "1.8.0",
  "description": "DimseScp server to connect to static-wado repo",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "DIMSESCP",
    "DICOM",
    "DICOMweb"
  ],
  "author": [
    "Bill Wallace <bill.wallace@radicalimaging.com>"
  ],
  "contributors": [
    "Chris Hafey <chafey@gmail.com>",
    "Rodolfo Costa <rodolfo.costa@radicalimaging.com>"
  ],
  "engines": {
    "node": ">=14.18.1",
    "npm": ">=6.14.15",
    "yarn": ">=1.22.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RadicalImaging/Static-DICOMWeb.git",
    "directory": "packages/static-wado-scp"
  },
  "bugs": {
    "url": "https://github.com/radicalimaging/static-dicomweb/issues"
  },
  "homepage": "https://github.com/radicalimaging/static-dicomweb#readme",
  "license": "ISC",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs",
      "esm": "./lib/index.mjs"
    }
  },
  "directories": {
    "lib": "lib",
    "bin": "bin"
  },
  "files": [
    "bin",
    "lib",
    "dist"
  ],
  "bin": {
    "dicomwebscp": "bin/dicomwebscp.mjs"
  },
  "scripts": {
    "test": "jest --config ./jest.config.js",
    "link:exec": "bun link",
    "build": "pnpm run build:esm",
    "build:esm": "node -e \"const fs=require('fs'); fs.mkdirSync('dist',{recursive:true}); fs.cpSync('lib','dist',{recursive:true});\"",
    "clean": "rimraf dist",
    "dicomwebscp": "bun bin/dicomwebscpDev.mjs --",
    "lint": "npx eslint --color \"**/*.{js,mjs,cjs}\"",
    "lint:fix": "npx eslint --fix --color \"**/*.{js,mjs,cjs}\""
  },
  "dependencies": {
    "@radicalimaging/create-dicomweb": ">=1.8.0",
    "@radicalimaging/static-wado-creator": ">=1.8.0",
    "@radicalimaging/static-wado-plugins": ">=1.8.0",
    "@radicalimaging/static-wado-util": ">=1.8.0",
    "config-point": "0.8.0",
    "dcmjs": "npm:@dcmjs-org/dcmjs@1.0.0-beta.10",
    "dcmjs-dimse": "0.3.4"
  },
  "devDependencies": {
    "must": "0.13.4"
  }
}
