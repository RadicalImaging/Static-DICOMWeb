{
  "name": "static-dicomweb",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=12.9.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.6",
    "@babel/eslint-parser": "7.28.6",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-transform-class-properties": "7.28.6",
    "@babel/plugin-transform-class-static-block": "7.28.6",
    "@babel/plugin-transform-modules-commonjs": "7.28.6",
    "@babel/plugin-transform-private-methods": "7.28.6",
    "@babel/plugin-transform-runtime": "7.28.5",
    "@babel/preset-env": "7.28.6",
    "@babel/preset-typescript": "7.28.5",
    "@babel/runtime": "7.28.6",
    "babel-plugin-transform-import-meta": "2.3.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-jest": "28.14.0",
    "eslint-plugin-prettier": "5.5.5",
    "execa": "7.2.0",
    "has-flag": "4.0.0",
    "jest": "29.7.0",
    "jest-config": "29.7.0",
    "jest-watcher": "29.7.0",
    "p-locate": "5.0.0",
    "prettier": "3.8.1",
    "rimraf": "6.1.2",
    "semver": "7.7.4",
    "tsx": "4.21.0",
    "webpack-cli": "5.1.4"
  },
  "dependencies": {
    "@cornerstonejs/dicom-codec": "1.1.6",
    "canvas": "3.1.0",
    "dcmjs": "0.52.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "cleanTgz": "rimraf ./packages/*/*.tgz || echo No tgz",
    "docker:build": "pnpm run cleanTgz && docker build . -t braveheartsoftware/static-dicomweb:latest",
    "docker:build:arm": "pnpm run cleanTgz && docker buildx build --platform linux/arm64 --load -t braveheartsoftware/static-dicomweb:arm .",
    "docker:run": "docker run -it --mount type=bind,source=/c/dicomweb,target=/dicomweb --mount type=bind,source=/a/dicom,target=/dicom -p 25080:5000  --rm --entrypoint /bin/bash braveheartsoftware/static-dicomweb:latest",
    "docker:dicomwebserver": "docker run -it --mount type=bind,source=/c/dicomweb,target=/dicomweb -p 25080:5000  --rm braveheartsoftware/static-dicomweb:latest",
    "test": "pnpm run test:release && pnpm -r --parallel --reporter-hide-prefix=false run test",
    "test:release": "node --test \"scripts/release/*.test.mjs\"",
    "supply-chain:ci": "bash ./scripts/ci-supply-chain.sh",
    "test:github": "pnpm run supply-chain:ci && pnpm run test",
    "test:ci": "pnpm run test:github",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:parallel": "pnpm -r run build",
    "build:serial": "pnpm -r --workspace-concurrency=1 run build",
    "build:esm": "pnpm -r run build:esm",
    "build:github": "pnpm run supply-chain:ci && pnpm run build",
    "build:ci": "pnpm run build:github",
    "clean": "pnpm -r run clean",
    "link:exec": "pnpm -r run link:exec",
    "lint": "pnpm -r --parallel run lint",
    "lint:ci": "pnpm run lint",
    "lint:fix": "echo format check",
    "format": "prettier --write \"packages/*/{lib,src}/**/*.{mjs,ts,js}\"",
    "postinstallManual": "git config core.hooksPath '.husky' && echo 'git hooks configured'",
    "pack:js": "pnpm -r run pack:js",
    "reset:hooks": "git config core.hooksPath '.git' && echo 'git hooks was reset'",
    "install:update-lockfile": "pnpm install --no-frozen-lockfile",
    "audit": "pnpm audit --audit-level=high"
  }
}
